#!/usr/bin/env python3
"""Agent Budget Sentinel — Live Terminal Telemetry Monitor & Braille Sparkline TUI.

Reads live telemetry from http://127.0.0.1:8110/api/stats (or falls back to local budget.db).
100% Python Standard Library — Zero External Dependencies.
Engineered by Neal Frazier Tech (@1nc0gn30) • NullAI Platform.
"""

from __future__ import annotations

import argparse
import json
import os
import sqlite3
import sys
import time
import urllib.request
from typing import Any, Dict, List

VERSION = "2.6.0"
BRAILLE_BASE = 0x2800
REPO_DIR = os.path.expanduser("~/NullAITech/agent-budget-sentinel")


def braille_sparkline(vals: List[float]) -> str:
    if not vals:
        return "\u28c0" * 12
    peak = max(vals) or 1.0
    norm = [max(0.0, min(1.0, v / peak)) for v in vals]
    if len(norm) % 2 == 1:
        norm.append(norm[-1])
    out = []
    for i in range(0, len(norm), 2):
        v1 = max(0, min(3, int(norm[i] * 3.99)))
        v2 = max(0, min(3, int(norm[i + 1] * 3.99)))
        dots1 = (0x40, 0x04, 0x02, 0x01)[v1]
        dots2 = (0x80, 0x20, 0x10, 0x08)[v2]
        out.append(chr(BRAILLE_BASE | dots1 | dots2))
    return "".join(out)


def fetch_live_snapshot(host: str, port: int, db_path: str) -> Dict[str, Any]:
    t0 = time.perf_counter()
    try:
        req = urllib.request.Request(f"http://{host}:{port}/api/stats")
        with urllib.request.urlopen(req, timeout=2.5) as resp:
            stats = json.loads(resp.read().decode("utf-8"))
        tx_req = urllib.request.Request(f"http://{host}:{port}/api/transactions?limit=12")
        with urllib.request.urlopen(tx_req, timeout=2.5) as resp:
            txs = json.loads(resp.read().decode("utf-8")).get("transactions", [])
        rtt_ms = round((time.perf_counter() - t0) * 1000.0, 2)
        return {
            "source": f"http://{host}:{port}",
            "online": True,
            "rtt_ms": rtt_ms,
            "stats": stats,
            "transactions": txs,
        }
    except Exception as exc:
        if os.path.exists(db_path):
            conn = sqlite3.connect(db_path, timeout=3.0)
            conn.row_factory = sqlite3.Row
            try:
                agg = conn.execute("""
                    SELECT
                        COALESCE(SUM(CASE WHEN tripped = 0 THEN cost_usd ELSE 0 END), 0.0) AS spend,
                        COALESCE(SUM(CASE WHEN tripped = 0 THEN prompt_tokens ELSE 0 END), 0) AS p_tok,
                        COALESCE(SUM(CASE WHEN tripped = 0 THEN completion_tokens ELSE 0 END), 0) AS c_tok,
                        COALESCE(SUM(CASE WHEN tripped = 0 THEN 1 ELSE 0 END), 0) AS reqs,
                        COALESCE(SUM(CASE WHEN tripped = 1 THEN 1 ELSE 0 END), 0) AS blocked
                    FROM transactions
                """).fetchone()
                rows = [
                    dict(r)
                    for r in conn.execute(
                        "SELECT id, timestamp, model, prompt_tokens, completion_tokens, cost_usd, status_code, tripped "
                        "FROM transactions ORDER BY id DESC LIMIT 12"
                    ).fetchall()
                ]
            finally:
                conn.close()
            spend = round(float(agg["spend"] or 0.0), 6)
            return {
                "source": db_path,
                "online": False,
                "rtt_ms": round((time.perf_counter() - t0) * 1000.0, 2),
                "stats": {
                    "state": "OFFLINE",
                    "current_spend_usd": spend,
                    "max_budget_usd": 5.0,
                    "remaining_budget_usd": max(0.0, round(5.0 - spend, 6)),
                    "percentage_used": min(100.0, round((spend / 5.0) * 100.0, 2)),
                    "velocity_usd_per_min": 0.0,
                    "velocity_limit_usd_per_min": 2.0,
                    "total_prompt_tokens": int(agg["p_tok"] or 0),
                    "total_completion_tokens": int(agg["c_tok"] or 0),
                    "total_tokens": int((agg["p_tok"] or 0) + (agg["c_tok"] or 0)),
                    "total_requests": int(agg["reqs"] or 0),
                    "blocked_requests": int(agg["blocked"] or 0),
                },
                "transactions": rows,
                "note": f"Live daemon unreachable ({exc}); showing SQLite ledger snapshot.",
            }
        return {
            "source": "none",
            "online": False,
            "rtt_ms": round((time.perf_counter() - t0) * 1000.0, 2),
            "stats": {"state": "OFFLINE", "error": str(exc)},
            "transactions": [],
        }


def render_tui(snap: Dict[str, Any]) -> None:
    s = snap["stats"]
    txs = snap["transactions"]
    costs = [float(t.get("cost_usd") or 0.0) for t in reversed(txs)]
    spark = braille_sparkline(costs if any(c > 0 for c in costs) else [0.0] * 12)
    state = s.get("state", "OFFLINE")
    c_gold, c_em, c_red, c_dim, c_rst = "\033[33m", "\033[32m", "\033[31m", "\033[2m", "\033[0m"
    st_col = c_em if state == "CLOSED" else (c_gold if state == "WARN" else c_red)

    print(f"{c_gold}⚡ AGENT BUDGET SENTINEL TUI v{VERSION}{c_rst}  [{snap['source']} · {snap['rtt_ms']} ms]")
    print(f"   Breaker:  {st_col}{state}{c_rst}   |   Spend: ${s.get('current_spend_usd', 0):.4f} / ${s.get('max_budget_usd', 5):.2f} ({s.get('percentage_used', 0):.1f}%)")
    print(f"   Velocity: ${s.get('velocity_usd_per_min', 0):.4f}/min (cap ${s.get('velocity_limit_usd_per_min', 2):.2f}/min)   |   Requests: {s.get('total_requests', 0)} (blocked: {s.get('blocked_requests', 0)})")
    print(f"   Tokens:   {s.get('total_tokens', 0):,} total ({s.get('total_prompt_tokens', 0):,} in / {s.get('total_completion_tokens', 0):,} out)")
    print(f"   Burn:     {c_gold}{spark}{c_rst} {c_dim}(last {len(txs)} transactions){c_rst}")
    if txs:
        print(f"   {c_dim}Recent:{c_rst}")
        for t in txs[:5]:
            toks = int(t.get("prompt_tokens") or 0) + int(t.get("completion_tokens") or 0)
            flag = "429 TRIPPED" if (t.get("tripped") or t.get("status_code") == 429) else f"{t.get('status_code', 200)} OK"
            print(f"     - {t.get('model','unknown'):<22} {toks:>7,} tok   ${float(t.get('cost_usd') or 0):.5f}   [{flag}]")


def main() -> None:
    ap = argparse.ArgumentParser(description="Agent Budget Sentinel Live Terminal Monitor")
    ap.add_argument("--host", default="127.0.0.1", help="Daemon host (default 127.0.0.1)")
    ap.add_argument("--port", type=int, default=8110, help="Daemon web port (default 8110)")
    ap.add_argument("--db", default=os.path.join(REPO_DIR, "budget.db"), help="Fallback SQLite DB path")
    ap.add_argument("--json", action="store_true", help="Emit live JSON telemetry snapshot and exit")
    ap.add_argument("--status", action="store_true", help="Render single telemetry frame and exit")
    ap.add_argument("--watch", action="store_true", help="Refresh continuously every 2 seconds")
    args = ap.parse_args()

    snap = fetch_live_snapshot(args.host, args.port, args.db)
    costs = [float(t.get("cost_usd") or 0.0) for t in reversed(snap["transactions"])]
    spark = braille_sparkline(costs if any(c > 0 for c in costs) else [0.0] * 12)

    if args.json:
        print(json.dumps({
            "tool": "agent-budget-sentinel",
            "version": VERSION,
            "online": snap["online"],
            "source": snap["source"],
            "rtt_ms": snap["rtt_ms"],
            "braille_burn_sparkline": spark,
            "stats": snap["stats"],
            "recent_transactions_count": len(snap["transactions"]),
        }, indent=2))
        sys.exit(0 if snap["online"] or snap["source"] != "none" else 1)

    if args.watch:
        try:
            while True:
                sys.stdout.write("\033[2J\033[H")
                render_tui(fetch_live_snapshot(args.host, args.port, args.db))
                sys.stdout.flush()
                time.sleep(2.0)
        except KeyboardInterrupt:
            return
    else:
        render_tui(snap)


if __name__ == "__main__":
    main()
